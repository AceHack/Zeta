<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Zeta.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ZSetBench.fs" />
    <Compile Include="CircuitBench.fs" />
    <Compile Include="SpineBench.fs" />
    <Compile Include="BloomBench.fs" />
    <Compile Include="QuantumOracleBench.fs" />
    <Compile Include="Nexmark.fs" />
    <Compile Include="NexmarkFull.fs" />
    <Compile Include="CheckedVsUncheckedBench.fs" />
    <Compile Include="ZSetWBench.fs" />
    <Compile Include="ColumnZSetBench.fs" />
    <Compile Include="ColumnLinearOpsBench.fs" />
    <Compile Include="BonsaiBench.fs" />
    <Compile Include="GitBench.fs" />
    <Compile Include="DurabilityBench.fs" />
    <Compile Include="PersistenceFormatsBench.fs" />
    <Compile Include="GitMergeFlushBench.fs" />
    <Compile Include="GitSnapshotBench.fs" />
    <Compile Include="EncryptedDiskBackingStoreBench.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.fsproj" />
    <ProjectReference Include="..\..\src\Core.CSharp.Bonsai\Zeta.Core.CSharp.Bonsai.csproj" />
    <ProjectReference Include="..\..\src\Core.FSharp.Git\Zeta.Core.FSharp.Git.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
</Project>
