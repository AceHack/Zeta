<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.1.400" />
    <PackageVersion Include="Blake3" Version="3.0.2" />
    <PackageVersion Include="G-Research.FSharp.Analyzers" Version="0.23.0" />
    <PackageVersion Include="Ionide.Analyzers" Version="0.17.0" />
    <PackageVersion Include="FSharp.Analyzers.Build" Version="0.5.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.177" />
    <!-- SonarAnalyzer.CSharp pinned but NOT referenced from
         Directory.Build.props yet — surfaces 15+ real findings
         (S1905 unnecessary casts, S6966 SendAsync, S2699
         assertionless tests) that need a cleanup pass first.
         Version pinned here so the BACKLOG'd cleanup round can
         flip the switch by adding one ItemGroup line. -->
    <!-- Microsoft.CodeAnalysis.CSharp: Roslyn compiler API, referenced PrivateAssets="all" by the
         C# source-generator (approach A) in src/Core.CSharp.TypeProvider. Pinned to match the
         Roslyn bundled in the .NET SDK, verified by executing the SDK's own
         Roslyn/bincore/csc.dll; never inferred from the SDK's version number. An
         analyzer/generator must not reference a NEWER Roslyn than the host compiler can
         load (CS9057, a BUILD failure, not a runtime one). Exact-pinned per supply-chain
         doctrine.

         The pin moves ONLY on a FEATURE-band SDK roll, because only a feature band moves the
         bundled Roslyn minor. Measured history, each row read off csc.dll:
           SDK 10.0.203 -> 5.3.0
           SDK 10.0.302 -> 5.6.0-2.26329.109
           SDK 10.0.303 -> 5.6.0-2.26377.103   (patch roll: minor UNCHANGED, pin held)
           SDK 10.0.400 -> 5.9.0-1.26379.115   (feature-band roll: minor MOVED, pin moves)
         Enforced by src/Core.TypeScript/hygiene/audit-codeanalysis-sdk-match.ts (the CI job
         whose name is the phrase "CodeAnalysis pins <= SDK Roslyn"), which MEASURES the SDK
         rather than trusting this comment.

         NOTE for whoever edits this block next: an XML comment may not contain a double
         hyphen, which is why the guard's CI job name is spelled out above rather than
         quoted verbatim. Getting it wrong does not fail where you would look: the file
         stops parsing, ManagePackageVersionsCentrally silently stops applying, and every
         F# project fails restore with NU1504 duplicate FSharp.Core, which reads exactly
         like an SDK regression. Measured 2026-08-25 by making the mistake during the
         10.0.400 roll; a control build on the OLD SDK reproduced it and cleared the SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.ML.Probabilistic.Compiler" Version="0.4.2504.701" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.19.0.132793" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="FsCheck" Version="3.3.4" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.3.4" />
    <PackageVersion Include="FsUnit.Xunit" Version="7.1.1" />
    <PackageVersion Include="Unquote" Version="7.0.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Z3" Version="4.12.2" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <!-- Google.Protobuf: TEST-ONLY (Tests.FSharp) — the vendored protobuf lib used to prove our
         hand-rolled wire codec is byte-identical (the hexagonal swap conformance). NOT a production
         dependency of Core. Exact-pinned per the supply-chain doctrine. -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.11" />
    <PackageVersion Include="FsPickler" Version="5.3.2" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Apache.Arrow" Version="23.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- martinothamar/Mediator: the mediator pattern via Roslyn SOURCE GENERATORS (no runtime
         reflection dispatch), MIT-licensed. Deliberately hexagonal'd behind our own Zeta.Mediator.*
         port (src/Core.CSharp.Mediator) — every Mediator.* reference is confined to the port + the
         edge composition root, so we can REPLACE it (it is intentionally one of our first replaceable
         deps). NOT MediatR (commercial license + runtime reflection). Exact-pinned per the
         supply-chain doctrine; SourceGenerator + Abstractions held at the same version. -->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <!-- Microsoft first-party DI: the IServiceCollection seam the mediator registers into.
         Abstractions for the port library; the full container for the proving test. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <!-- OpenTelemetry: the exporter side of the instrumentation src/Core/Metrics.fs and
         src/Core/Tracing.fs have published since long before anything listened. Referenced
         ONLY by src/Core.Telemetry (the composition root) and the test project that proves
         data arrives - never by Core itself, so a consumer of the DBSP library does not
         inherit an exporter stack it did not ask for.
         OpenTelemetry.Exporter.InMemory is TEST-ONLY: it is the seam that turns "the code
         compiles" into "the counters actually reach an exporter". All three held at the
         same version - the SDK and its exporters are a matched set. Exact-pinned per the
         supply-chain doctrine. -->
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
  </ItemGroup>
</Project>