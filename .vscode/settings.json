{
  // Shape mirrors SQLSharp's `.vscode/settings.json` so
  // contributors get consistent editor behaviour around Zeta's
  // build outputs + vendored prior-art mirrors.
  "dotnet.defaultSolution": "Zeta.sln",

  "files.exclude": {
    "**/BenchmarkDotNet.Artifacts/**": true,
    "**/TestResults/**": true,
    "**/artifacts/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true,
    "**/.lake/**": true,
    "**/src/Core.Rust.*/target/**": true,
    "**/references/prior-art/**": true
  },
  "files.watcherExclude": {
    "**/BenchmarkDotNet.Artifacts/**": true,
    "**/TestResults/**": true,
    "**/artifacts/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true,
    "**/.lake/**": true,
    "**/src/Core.Rust.*/target/**": true,
    "**/references/prior-art/**": true,
    "**/tests/cross-verification/experience/fixtures/tree1/subdir1/link_to_parent": true,
    "**/docs/github/**": true,
    "**/docs/history/**": true,
    "**/docs/observe-events/**": true,
    "**/docs/hygiene-history/**": true,
    "**/docs/pr-discussions/**": true,
    "**/docs/drift-events/**": true,
    "**/docs/recovered-orphan-branches-2026-05/**": true,
    "**/data/tick-shards/**": true,
    "**/workitems/events/**": true
  },
  "search.exclude": {
    "**/BenchmarkDotNet.Artifacts/**": true,
    "**/TestResults/**": true,
    "**/artifacts/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true,
    "**/.lake/**": true,
    "**/src/Core.Rust.*/target/**": true,
    "**/references/prior-art/**": true,
    "**/tests/cross-verification/experience/fixtures/tree1/subdir1/link_to_parent": true,
    "**/docs/github/**": true,
    "**/docs/history/**": true,
    "**/docs/observe-events/**": true,
    "**/docs/hygiene-history/**": true,
    "**/docs/pr-discussions/**": true,
    "**/docs/drift-events/**": true,
    "**/docs/recovered-orphan-branches-2026-05/**": true,
    "**/data/tick-shards/**": true,
    "**/workitems/events/**": true
  },

  "FSharp.excludeProjectDirectories": [
    ".git",
    "bin",
    "obj",
    "node_modules",
    "tools/lean4/.lake",
    "src/Core.Lean4/.lake",
    "references/prior-art"
  ],

  "shellcheck.customArgs": ["-x"],
  "shellcheck.useWorkspaceRootAsCwd": true,

  // SonarLint VS Code extension — exclude generated + vendored
  // surfaces from analysis so the SonarAnalyzer.CSharp Roslyn
  // pack (see Directory.Build.props) only scans Zeta's own source.
  // Matches the files.exclude / search.exclude shape above.
  "sonarlint.analysisExcludesStandalone": {
    "**/BenchmarkDotNet.Artifacts/**": true,
    "**/TestResults/**": true,
    "**/artifacts/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true,
    "**/tools/lean4/.lake/**": true,
    "**/.lake/**": true,
    "**/references/prior-art/**": true,
    "**/.vscode/**": true,
    "**/.claude/**": true,
    "**/memory/**": true,
    "**/docs/**": true
  },

  "[fsharp]": {
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[json]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.formatOnSave": false
  }
}
