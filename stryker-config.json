{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/docs/stryker-config.schema.json",
  "stryker-config": {
    "project": "src/Core.CSharp/Core.CSharp.csproj",
    "test-projects": [
      "tests/Core.CSharp.Tests/Core.CSharp.Tests.csproj"
    ],
    "mutate": [
      "!**/AssemblyInfo.cs",
      "!**/bin/**",
      "!**/obj/**"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "since": { "enabled": false }
  }
}
