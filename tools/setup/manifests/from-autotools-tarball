# Mechanism: from-autotools-tarball — fetch upstream tarball, verify sha256, configure + make install.
# Format: <binary-name>  <tarball-url>  sha256=<hex>  [prefix=~/.local]  [when=linux]
#
# Linux-only formal solvers when distro packages are broken or absent (Noble apt eprover 3.0.03
# aborts in CI; Jammy has no eprover apt). macOS uses manifests/brew.
#
# E prover source is pinned to the official GitHub tag archive instead of the
# DHBW E.tgz download host because the DHBW host was unreachable from CI on
# 2026-07-02. The SHA pin still guards the exact content we build.

eprover  https://github.com/eprover/eprover/archive/refs/tags/E-3.2.0.tar.gz  sha256=1c14cf7c472afb17bff7aa76777259c4d2539edadef60edd7dc53fde5c642002  when=linux
