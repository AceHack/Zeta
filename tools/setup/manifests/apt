libicu74          # ICU — .NET globalization (the classic "dotnet exited" cause)
libssl3t64        # OpenSSL 3 runtime (Noble t64 name)
libgssapi-krb5-2  # Kerberos/GSSAPI — .NET networking
tzdata            # timezone data — .NET DateTime

