<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Zeta.Core.FSharp.Yaml</RootNamespace>
    <AssemblyName>Zeta.Core.FSharp.Yaml</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Zero external dependencies in the production library -->

  <ItemGroup>
    <Compile Include="Reader.fs" />
    <Compile Include="Dom.fs" />
  </ItemGroup>

</Project>
