<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Zeta.Bayesian</RootNamespace>
    <AssemblyName>Zeta.Bayesian</AssemblyName>
    <PackageId>Zeta.Bayesian</PackageId>
    <Description>Bayesian aggregates over DBSP Z-set streams. Conjugate-prior online posteriors (Beta/Normal-Inverse-Gamma/Dirichlet) as first-class operators. Opt-in: this project doesn't enforce PublishAot=true because it may optionally use Infer.NET, which depends on reflection-emit.</Description>
    <!-- Explicitly NOT AOT-enforced — this is a plugin. Core stays AOT-clean. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="BoundJustification.fs" />
    <Compile Include="Message.fs" />
    <Compile Include="Attested.fs" />
    <Compile Include="HeavyTailFold.fs" />
    <Compile Include="QuantumFusion.fs" />
    <Compile Include="MessageBatch.fs" />
    <Compile Include="FactorGraph.fs" />
    <Compile Include="Ep.fs" />
    <Compile Include="BayesianAggregate.fs" />
    <Compile Include="EngineAdapter.fs" />
    <Compile Include="InferNetTopology.fs" />
    <Compile Include="SocietyBootstrap.fs" />
    <Compile Include="AttentionRouter.fs" />
    <Compile Include="InformationValue.fs" />
    <Compile Include="ReportTriage.fs" />
    <Compile Include="MinimalBnn.fs" />
    <Compile Include="MultilayerBnn.fs" />
    <Compile Include="BusRegime.fs" />
    <Compile Include="BayesianTemperature.fs" />
    <Compile Include="AntiSybil.fs" />
    <Compile Include="CliffordAntiSybil.fs" />
    <Compile Include="CloneDetectionBenchmark.fs" />
    <Compile Include="LocalConsensus.fs" />
    <Compile Include="ThousandBrains.fs" />
    <Compile Include="YinYangCell.fs" />
    <Compile Include="ThousandBrainsCron.fs" />
    <Compile Include="YinYangEnsemble.fs" />
    <Compile Include="SequentialEnsemble.fs" />
    <Compile Include="WeaviateMemory.fs" />
    <Compile Include="BusDelayTick.fs" />
    <Compile Include="MutualFalsification.fs" />
    <Compile Include="CondorcetBoundary.fs" />
    <Compile Include="BusDelaySim.fs" />
    <Compile Include="OrbitalAsymmetryBudget.fs" />
    <Compile Include="FigureEightEnsemble.fs" />
    <Compile Include="LagrangeCondorcet.fs" />
    <Compile Include="AskBidClearing.fs" />
    <Compile Include="MeshLatencyModel.fs" />
    <Compile Include="ReticulumBusMeter.fs" />
    <Compile Include="GossipTelemetry.fs" />
    <Compile Include="KeptClaimOracle.fs" />
    <Compile Include="Web3Settlement.fs" />
    <Compile Include="SparseSocietyNetwork.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Apache.Arrow" />
  </ItemGroup>
</Project>
