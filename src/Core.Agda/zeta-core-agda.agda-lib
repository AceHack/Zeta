-- src/Core.Agda — the cubical Agda proof home (provided-view univalence
-- obligation lane; docs/letters/from-soraya-univalence-lane-routing.md,
-- workitem 081KX1VE4G808QG0R003DCK3GV).
-- `cubical` resolves via the Agda user libraries file, registered by
-- tools/setup/common/agda-cubical.sh at the pinned release matching the
-- installed Agda (pin-pair table: tools/setup/manifests/from-agda-cubical).
-- NOTE: upstream names its library `cubical-<version>` (e.g. cubical-0.9);
-- Agda's versioned-name matching lets `depend: cubical` resolve whichever
-- pinned tag is registered.
name: zeta-core-agda
include: .
depend: cubical
