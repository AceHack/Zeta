{
  "primitive": "versionstamp-codec",
  "version": "v1",
  "why": "Gate T2 — 4-language byte-lock on the Versionstamp canonical encoding. The versionstamp is an int64 treated as unsigned 64-bit in network byte order (big-endian, 8 bytes). This is the wire format for the tick index in the DBSP belief stream. All four oracles (F#/C#/TS/Rust) must produce identical hex strings for each value.",
  "encoding": "big-endian uint64, 8 bytes, hex-encoded (no prefix); version is a DECIMAL STRING because JSON numbers lose int64 precision in float64 readers (JS: 9223372036854775807 -> ...776000)",
  "vectors": [
    { "name": "zero",          "version": "0",                    "hex": "0000000000000000" },
    { "name": "one",           "version": "1",                    "hex": "0000000000000001" },
    { "name": "two",           "version": "2",                    "hex": "0000000000000002" },
    { "name": "255",           "version": "255",                  "hex": "00000000000000ff" },
    { "name": "256",           "version": "256",                  "hex": "0000000000000100" },
    { "name": "65535",         "version": "65535",                "hex": "000000000000ffff" },
    { "name": "65536",         "version": "65536",                "hex": "0000000000010000" },
    { "name": "1M",            "version": "1000000",              "hex": "00000000000f4240" },
    { "name": "1B",            "version": "1000000000",           "hex": "000000003b9aca00" },
    { "name": "max-int32",     "version": "2147483647",           "hex": "000000007fffffff" },
    { "name": "max-int32+1",   "version": "2147483648",           "hex": "0000000080000000" },
    { "name": "max-uint32",    "version": "4294967295",           "hex": "00000000ffffffff" },
    { "name": "max-uint32+1",  "version": "4294967296",           "hex": "0000000100000000" },
    { "name": "1T",            "version": "1000000000000",        "hex": "000000e8d4a51000" },
    { "name": "max-int63",     "version": "9223372036854775807",  "hex": "7fffffffffffffff" },
    { "name": "typical-tick",  "version": "42",                   "hex": "000000000000002a" }
  ]
}
