<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Zeta.Core.FSharp.ZetaId</RootNamespace>
    <AssemblyName>Zeta.Core.FSharp.ZetaId</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Zero external dependencies in the production library -->

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="BitLayout.fs" />
    <Compile Include="Codec.fs" />
  </ItemGroup>

</Project>
