{
  "schema": "zeta-ir-v2-interface",
  "name": "ISemiring",
  "typeParams": [
    {
      "name": "TWeight",
      "variance": "invariant"
    }
  ],
  "doc": "Semiring (rig) interface — the free tier for DBSP weights: Zero/One/Add/Mul, NO additive inverse (idempotent semirings are provably zerosumfree: Vandiver 1934, Golan 1999). Retraction lives in IRing (081KWG9JQ9H).",
  "members": [
    {
      "name": "Zero",
      "kind": "property",
      "type": "TWeight",
      "doc": "Additive identity."
    },
    {
      "name": "One",
      "kind": "property",
      "type": "TWeight",
      "doc": "Multiplicative identity."
    },
    {
      "name": "Add",
      "kind": "method",
      "params": [
        {
          "name": "a",
          "type": "TWeight"
        },
        {
          "name": "b",
          "type": "TWeight"
        }
      ],
      "returns": "TWeight",
      "doc": "Additive combination (⊕)."
    },
    {
      "name": "Mul",
      "kind": "method",
      "params": [
        {
          "name": "a",
          "type": "TWeight"
        },
        {
          "name": "b",
          "type": "TWeight"
        }
      ],
      "returns": "TWeight",
      "doc": "Multiplicative product (⊗)."
    }
  ],
  "laws": [
    {
      "id": "add-assoc",
      "schema": "associative",
      "op": "Add",
      "status": "proven",
      "proof": "src/Core.TypeScript/algebra/interfaces.test.ts:add-is-associative",
      "doc": "Add(Add(a,b),c) = Add(a,Add(b,c))"
    },
    {
      "id": "add-comm",
      "schema": "commutative",
      "op": "Add",
      "status": "proven",
      "proof": "src/Core.TypeScript/algebra/interfaces.test.ts:add-is-commutative",
      "doc": "Add(a,b) = Add(b,a)"
    },
    {
      "id": "add-identity",
      "schema": "identity",
      "op": "Add",
      "element": "Zero",
      "status": "proven",
      "proof": "src/Core.TypeScript/algebra/interfaces.test.ts:zero-is-additive-identity",
      "doc": "Add(a, Zero) = a"
    },
    {
      "id": "mul-identity",
      "schema": "identity",
      "op": "Mul",
      "element": "One",
      "status": "proven",
      "proof": "src/Core.TypeScript/algebra/interfaces.test.ts:one-is-multiplicative-identity",
      "doc": "Mul(a, One) = a = Mul(One, a)"
    },
    {
      "id": "mul-distributes-add",
      "schema": "distributive",
      "mul": "Mul",
      "add": "Add",
      "status": "proven",
      "proof": "src/Core.TypeScript/algebra/interfaces.test.ts:mul-distributes-over-add",
      "doc": "Mul(a, Add(b,c)) = Add(Mul(a,b), Mul(a,c))"
    }
  ]
}
