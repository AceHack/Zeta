{
  "name": "zeta-repo-tooling",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "workspaces": [
    "src/apps/twitch-ai"
  ],
  "scripts": {
    "tally:substrates": "bun ./src/Core.TypeScript/invariant-substrates/tally.ts",
    "build-graph:affected": "bun ./src/Core.TypeScript/ace/build-graph.ts affected",
    "build-graph:derive": "bun ./src/Core.TypeScript/ace/build-graph.ts derive",
    "build-graph:quorum": "bun ./src/Core.TypeScript/ace/build-graph.ts quorum",
    "generate:transcript": "bun ./src/Core.QSharp.ReferenceOracle/generate-treaty-transcript.ts",
    "lint:typescript": "bun ./src/Core.TypeScript/lint/lint-typescript.ts",
    "lint:eslint": "eslint eslint.config.ts src/Core.QSharp.ReferenceOracle src/Core.TypeScript/agent-bus src/Core.TypeScript/ansi src/Core.TypeScript/audit-packages src/Core.TypeScript/byte-cost src/Core.TypeScript/claude-hooks src/Core.TypeScript/enforcement src/Core.TypeScript/federated-identity src/Core.TypeScript/fuzz src/Core.TypeScript/g-set src/Core.TypeScript/git src/Core.TypeScript/io-boundary src/Core.TypeScript/lanes src/Core.TypeScript/mixin src/Core.TypeScript/pam src/Core.TypeScript/persistence src/Core.TypeScript/privilege src/Core.TypeScript/resource-planner src/Core.TypeScript/splitmix64 src/Core.TypeScript/tradition-density src/Core.TypeScript/watermark src/Core.TypeScript/z-set src/Core.TypeScript/zetadb",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "format:check": "prettier --check \"**/*.{json,jsonc,md,markdown,ts,toml,yml,yaml,css}\"",
    "format:write": "prettier --write \"**/*.{json,jsonc,md,markdown,ts,toml,yml,yaml,css}\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit --pretty false",
    "check:loop-liveness": "bun ./src/Core.TypeScript/service/loop-liveness.ts",
    "preflight": "bun ./src/Core.TypeScript/hygiene/preflight.ts",
    "preflight:quick": "bun ./src/Core.TypeScript/hygiene/preflight.ts --quick",
    "pages:build": "bun ./src/Core.TypeScript/discovery/llmtv-pages-static-export.ts --out-dir dist && bun ./src/Core.TypeScript/browser-node/browser-pwa-build.ts --out-dir dist/hall/room && bun ./src/Core.TypeScript/browser-node/browser-database-receipt-pages-build.ts --out-dir dist/hall/room && bun ./src/Core.TypeScript/discovery/identity-dla-pages-build.ts && bun ./src/Core.TypeScript/discovery/explainers-pages-build.ts --out-dir dist && cd src/apps/twitch-ai && bun install && bun run build:gh-pages && cd ../../.. && mkdir -p dist/twitch-ai && cp -r src/apps/twitch-ai/dist/* dist/twitch-ai/",
    "build:browser-pwa": "bun ./src/Core.TypeScript/browser-node/browser-pwa-build.ts --out-dir dist/hall/room",
    "test:typescript": "bun test",
    "install:browser-smoke": "playwright install chromium",
    "test:browser-multitab": "bun ./src/Core.TypeScript/browser-node/browser-multitab-smoke.ts",
    "test:browser-revision-policy": "bun ./src/Core.TypeScript/browser-node/browser-revision-policy-smoke.ts",
    "test:browser-pwa": "bun ./src/Core.TypeScript/browser-node/browser-pwa-smoke.ts",
    "test:browser-admission": "bun ./src/Core.TypeScript/browser-node/browser-execution-admission-smoke.ts",
    "setup:touchid-sudo": "bun ./tools/setup/touchid-sudo.ts --apply",
    "setup:touchid-sudo-verify": "bun ./tools/setup/touchid-sudo.ts --verify",
    "run:zetadb-node": "bun ./src/Core.TypeScript/zetadb/scheduled-node.ts",
    "run:proposal-device-relay": "bun ./src/Core.TypeScript/browser-node/browser-delegated-device-proposal-relay-host.ts",
    "hygiene:sort-tick-history": "bun ./src/Core.TypeScript/hygiene/sort-tick-history-canonical.ts",
    "hygiene:fix-markdown": "bun ./src/Core.TypeScript/hygiene/fix-markdown-md032-md026.ts",
    "hygiene:check-bash-retirement-inventory": "bun ./src/Core.TypeScript/hygiene/check-bash-retirement-inventory.ts --enforce",
    "hygiene:measure-shell-key-exposure": "bun ./src/Core.TypeScript/hygiene/measure-shell-key-exposure.ts",
    "hygiene:stage0-independence": "bun ./src/Core.TypeScript/hygiene/measure-stage0-independence.ts --enforce",
    "hygiene:mise-pin-parity": "bun ./src/Core.TypeScript/hygiene/mise-pin-parity.ts",
    "hygiene:dotnet-pin-parity": "bun ./src/Core.TypeScript/hygiene/audit-dotnet-pin-parity.ts",
    "hygiene:mise-toolchain-couplings": "bun ./src/Core.TypeScript/hygiene/audit-mise-toolchain-couplings.ts",
    "hygiene:no-ambient-credential-hoist": "bun ./src/Core.TypeScript/hygiene/lint-no-ambient-credential-hoist.ts",
    "hygiene:no-culture-sensitive-collation": "bun ./src/Core.TypeScript/hygiene/lint-no-culture-sensitive-collation.ts",
    "hygiene:no-decide-by-grep": "bun ./src/Core.TypeScript/hygiene/lint-no-decide-by-grep.ts",
    "hygiene:no-check-then-use-file-races": "bun ./src/Core.TypeScript/hygiene/lint-check-then-use-file-races.ts src/Core.TypeScript --min-files 1500 --baseline src/Core.TypeScript/hygiene/lint-check-then-use-file-races.baseline.json",
    "hygiene:no-ambient-time-in-tests": "bun ./src/Core.TypeScript/hygiene/audit-ambient-time-in-tests.ts",
    "hygiene:check-arity": "bun ./src/Core.TypeScript/hygiene/audit-check-arity.ts",
    "hygiene:check-arity-nonequality": "bun ./src/Core.TypeScript/hygiene/audit-check-arity-nonequality.ts",
    "hygiene:scan-floor-routes": "bun ./src/Core.TypeScript/hygiene/audit-scan-floor-routes.ts",
    "hygiene:linter-coverage": "bun ./src/Core.TypeScript/hygiene/audit-linter-coverage-vs-invocation.ts",
    "hygiene:tech-radar-claims": "bun ./src/Core.TypeScript/hygiene/audit-tech-radar-claims.ts",
    "inventory:items": "bun ./src/Core.TypeScript/inventory/generate-items-json.ts",
    "inventory:items-check": "bun ./src/Core.TypeScript/inventory/generate-items-json.ts --check",
    "inventory:reconcile": "bun ./src/Core.TypeScript/inventory/reconcile-surfaces.ts",
    "inventory:repin": "bun ./src/Core.TypeScript/inventory/reconcile-surfaces.ts --repin",
    "measure": "bun ./src/Core.TypeScript/ledger/measure.ts",
    "shadow": "bun src/Core.TypeScript/shadow/zeta-shadow.ts",
    "summon": "bun ./src/Core.TypeScript/peer-call/summon.ts"
  },
  "bin": {
    "ace": "src/Core.TypeScript/ace/ace.ts",
    "zeta-shadow": "src/Core.TypeScript/shadow/zeta-shadow.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.12",
    "@types/semver": "7.7.1",
    "eslint": "10.2.1",
    "eslint-plugin-sonarjs": "4.0.3",
    "fast-check": "4.8.0",
    "globals": "17.5.0",
    "jiti": "2.6.1",
    "markdownlint-cli2": "0.22.1",
    "playwright": "1.62.1",
    "prettier": "3.8.3",
    "prettier-plugin-toml": "2.0.6",
    "quantum-circuit": "0.9.247",
    "semver": "7.8.1",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.2.0",
    "z3-solver": "5.1.0"
  },
  "overrides": {
    "smol-toml": "1.6.1"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@noble/post-quantum": "0.6.1",
    "@scure/base": "2.2.0",
    "@scure/bip32": "2.2.0",
    "@scure/bip39": "2.2.0",
    "cborg": "6.1.1",
    "epub-gen-memory": "^1.1.2",
    "micro-key-producer": "0.8.6",
    "pg": "8.21.0",
    "yaml": "^2.9.0"
  }
}
