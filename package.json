{
  "name": "zeta-repo-tooling",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "tally:substrates": "bun ./tools/invariant-substrates/tally.ts",
    "generate:transcript": "bun ./src/Core.QSharp.ReferenceOracle/generate-treaty-transcript.ts",
    "lint:typescript": "eslint .",
    "lint:markdown": "markdownlint-cli2",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "format:check": "prettier --check \"**/*.{json,jsonc,md,markdown,ts,toml,yml,yaml,css}\"",
    "format:write": "prettier --write \"**/*.{json,jsonc,md,markdown,ts,toml,yml,yaml,css}\"",
    "typecheck": "tsc --noEmit",
    "preflight": "bun ./src/Core.TypeScript/hygiene/preflight.ts",
    "preflight:quick": "bun ./src/Core.TypeScript/hygiene/preflight.ts --quick",
    "test:typescript": "bun test",
    "hygiene:sort-tick-history": "bun ./tools/hygiene/sort-tick-history-canonical.ts",
    "hygiene:fix-markdown": "bun ./tools/hygiene/fix-markdown-md032-md026.ts",
    "hygiene:check-bash-retirement-inventory": "bun ./src/Core.TypeScript/hygiene/check-bash-retirement-inventory.ts --enforce",
    "shadow": "bun src/Core.TypeScript/shadow/zeta-shadow.ts",
    "summon": "bun ./src/Core.TypeScript/peer-call/summon.ts"
  },
  "bin": {
    "ace": "src/Core.TypeScript/ace/ace.ts",
    "zeta-shadow": "src/Core.TypeScript/shadow/zeta-shadow.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.12",
    "@types/semver": "7.7.1",
    "eslint": "10.2.1",
    "eslint-plugin-sonarjs": "4.0.3",
    "fast-check": "4.8.0",
    "globals": "17.5.0",
    "jiti": "2.6.1",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.3",
    "prettier-plugin-toml": "2.0.6",
    "quantum-circuit": "0.9.247",
    "semver": "7.8.1",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "z3-solver": "4.16.0"
  },
  "overrides": {
    "smol-toml": "1.6.1"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@noble/post-quantum": "0.6.1",
    "@scure/base": "2.2.0",
    "@scure/bip32": "2.2.0",
    "@scure/bip39": "2.2.0",
    "cborg": "5.1.1",
    "micro-key-producer": "0.8.6",
    "pg": "8.21.0",
    "yaml": "2.9.0"
  }
}
