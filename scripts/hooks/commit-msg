#!/usr/bin/env bash
# commit-msg — strip / refuse Manus–Lumen shell-wrapper leaks in commit messages
# (081KWN0JKJV / 081KWMY831H). Observed leak on 44763cdc1:
#   __manus_ec=$?; trap '' PIPE; printf ... >&3; trap - PIPEfeat: ...
#
# Installed by scripts/hooks/install-git-hooks.sh (install.sh, nix develop,
# ACE from-git-hooks realizer). Do not edit .git/hooks/commit-msg directly.
set -euo pipefail

msg_file="${1:?commit-msg hook requires the message file path}"

# Portable in-place edit via temp file (macOS/BSD sed -i differs from GNU).
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Strip the known Manus PROMPT_COMMAND epilogue (glued or spaced before subject).
# Keep the pattern tight to the observed form so we never eat real prose.
sed -E \
  -e 's/__manus_ec=\$\?;[[:space:]]*trap[[:space:]]+'\'''\''[[:space:]]+PIPE;[[:space:]]*printf[[:space:]]+"%d:%s\\n"[[:space:]]+\$__manus_ec[[:space:]]+"\$PWD"[[:space:]]+2>\/dev\/null[[:space:]]+>&3;[[:space:]]*trap[[:space:]]+-[[:space:]]+PIPE//' \
  "$msg_file" >"$tmp"

# Fail-closed on the SUBJECT only (first line). Bodies may document the tokens
# (e.g. this commit's message) without being a live leak.
subject="$(head -n 1 "$tmp")"
if echo "$subject" | grep -qE '__manus_ec|trap '\'''\'' PIPE'; then
  echo "commit-msg: refused — Manus/Lumen shell-wrapper text still present in the commit subject." >&2
  echo "  Remove __manus_ec / trap '' PIPE plumbing from the subject and retry." >&2
  exit 1
fi

# Refuse an empty subject after sanitize (wrapper-only message).
first="$(head -n 1 "$tmp" | tr -d '[:space:]')"
if [ -z "$first" ]; then
  echo "commit-msg: refused — commit subject empty after sanitizing wrapper leak." >&2
  exit 1
fi

cat "$tmp" >"$msg_file"

# ---------------------------------------------------------------------------
# A `Task:` id that is well-formed and names nothing (AH006).
#
# The AgencySignature gate validates `Task:` for placeholder-ness and SHAPE,
# never existence — so an invented-but-well-formed ZetaId passes CI silently,
# and it is HARDER to spot than a placeholder because it looks exactly right.
# Catching it here means the author sees it while they still have the context to
# fix it, instead of a red check twenty minutes later on a PR.
#
# Written after its author did this TWICE in one day. Neither was deception: a
# long commit message, a reached-for value, `new-workitem.ts` not run. That is
# the ordinary shape of the mistake — see
# `.claude/rules/never-assume-malice-where-mistake-is-possible.md`.
#
# FAILS OPEN on missing tooling, CLOSED on an unresolvable id. A commit-msg hook
# that blocks every commit because `bun` is absent is worse than the defect it
# guards; CI is the backstop for that case, and it fails closed there.
# ---------------------------------------------------------------------------
task_id="$(grep -E '^Task:[[:space:]]*081[0-9A-Z]{23}[[:space:]]*$' "$msg_file" 2>/dev/null | head -n 1 | sed -E 's/^Task:[[:space:]]*//; s/[[:space:]]*$//' || true)"
if [ -n "$task_id" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$repo_root" ] && [ -d "$repo_root/workitems" ]; then
    # Resolution = a work-item file carries the id as its FILENAME PREFIX, in
    # either state. `workitems/done/` is a valid referent: state is a folder
    # here, so checking only the open set would refuse every commit whose item
    # has since been completed.
    if ! find "$repo_root/workitems" -type d -name events -prune -o \
              -type f -name "${task_id}-*.md" -print 2>/dev/null | grep -q .; then
      echo "commit-msg: refused — Task id '${task_id}' resolves to no work-item." >&2
      echo "  A well-formed id that names nothing passes the shape check and identifies nothing." >&2
      echo "  Mint one instead of writing one:" >&2
      echo "    bun src/Core.TypeScript/backlog/new-workitem.ts --type task|bug --title \"...\"" >&2
      echo "  ...then commit the work-item file alongside this change." >&2
      exit 1
    fi
  fi
fi

exit 0
