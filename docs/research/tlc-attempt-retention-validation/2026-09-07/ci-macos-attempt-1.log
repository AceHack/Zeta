2026-09-07T12:42:49.9523910Z   export LDFLAGS="-L/opt/homebrew/opt/cyrus-sasl/lib"
2026-09-07T12:42:49.9524500Z   export CPPFLAGS="-I/opt/homebrew/opt/cyrus-sasl/include"
