{
  "pkg": "zeta-portal-web",
  "globalName": "ZetaPortal",
  "shape": "package",
  "entry": "full-ai-cluster/portal/web/src/ds-entry.ts",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-css/compiled.css",
  "buildCmd": "cd full-ai-cluster/portal/web && bunx tailwindcss -c tailwind.ds-sync.config.js -i src/index.css -o .ds-css/compiled.css",
  "readmeHeader": ".design-sync/conventions.md",
  "extraFonts": ["node_modules/@fontsource-variable/inter/index.css", "../../../.design-sync/fonts/inter-alias.css"],
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "860x560" },
    "Sheet": { "cardMode": "single", "viewport": "960x600" },
    "Card": { "cardMode": "column" },
    "Input": { "cardMode": "column" },
    "MetricChart": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "Textarea": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "Badge": "src/components/ui/badge.tsx",
    "Button": "src/components/ui/button.tsx",
    "Card": "src/components/ui/card.tsx",
    "CardHeader": "src/components/ui/card.tsx",
    "CardTitle": "src/components/ui/card.tsx",
    "CardDescription": "src/components/ui/card.tsx",
    "CardContent": "src/components/ui/card.tsx",
    "CardFooter": "src/components/ui/card.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "DialogHeader": "src/components/ui/dialog.tsx",
    "DialogTitle": "src/components/ui/dialog.tsx",
    "DialogDescription": "src/components/ui/dialog.tsx",
    "DialogBody": "src/components/ui/dialog.tsx",
    "DialogFooter": "src/components/ui/dialog.tsx",
    "Input": "src/components/ui/input.tsx",
    "Label": "src/components/ui/input.tsx",
    "Textarea": "src/components/ui/input.tsx",
    "Select": "src/components/ui/input.tsx",
    "Sheet": "src/components/ui/sheet.tsx",
    "SheetHeader": "src/components/ui/sheet.tsx",
    "SheetTitle": "src/components/ui/sheet.tsx",
    "SheetBody": "src/components/ui/sheet.tsx",
    "Tabs": "src/components/ui/tabs.tsx",
    "TabsList": "src/components/ui/tabs.tsx",
    "TabsTrigger": "src/components/ui/tabs.tsx",
    "TabsContent": "src/components/ui/tabs.tsx",
    "HealthDot": "src/components/bits.tsx",
    "PersonaAvatar": "src/components/bits.tsx",
    "MetricChart": "src/components/MetricChart.tsx"
  }
}
