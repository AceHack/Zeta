# Agda interface-file cache (cubical proof lane, 081KX1VE4G808QG0R003DCK3GV).
# .agdai files are BINARY typecheck caches — regenerable from the .agda source
# + the pinned cubical clone, and banned from the tree per
# .claude/rules/no-binary-in-proof-lineage.md (verification artifacts are text).
src/Core.Agda/_build/

# The ARC-AGI dataset is a LOCAL CLONE, not a submodule. `fe38a2a8e` committed it as a bare
# gitlink (mode 160000) with no `.gitmodules` entry — there is no `.gitmodules` in this repo at
# all — so every submodule-aware checkout died on
#   fatal: No url found for submodule path 'data/ARC-AGI' in .gitmodules
# and took `gate (required)` down with it. `arc-harness.ts` states the intent plainly:
# "Ensure 'data/ARC-AGI' is cloned." Ignored so it cannot be re-added by accident.
data/ARC-AGI/

# `rendered-storage-claims.ts` chart cache. It `helm pull`s each Application's
# chart at its pinned targetRevision into `<repo>/.helm-render-cache/` (a
# `mkdirSync` at the repo root, and the path is not configurable away by
# default), so any run of `--write-snapshot` or the live audit leaves 4-5 MB of
# `.tgz` archives plus rendered values files untracked in the tree. They are
# BINARY, regenerable from the pins, and they are the *input* to the render —
# never the evidence, which is the text snapshot beside the checker. Ignored so
# a `git add -A` after running the audit cannot commit a chart tarball into the
# proof lineage (.claude/rules/no-binary-in-proof-lineage.md).
.helm-render-cache/

# Per-agent scratch, kept INSIDE the clone on purpose.
#
# Two agents lost work on 2026-08-21 to collisions in bare `/tmp`: shared paths
# there are not namespaced by clone, so two loops writing the same filename race
# and the loser never finds out. Scratch belongs beside the work it is scratch
# FOR -- one directory per clone, ignored so it can never be staged, and deleted
# with the clone rather than outliving it in a shared tmpdir.
.shadow-scratch/

# The ARC lane's local venv (its own uv project; never committed).
src/Arc.Python/.venv/

# The interpretability lane's local venv (its own uv project; never committed).
# ~2 GB installed once torch is unpacked -- the uv.lock is the committed artifact.
src/Interp.Python/.venv/
src/Arc.Python/recordings/
src/Arc.Python/environment_files/
.reaper-cache/
